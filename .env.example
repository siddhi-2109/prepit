
# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origins (replace with your real HTTPS frontend domain on deployment)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
CSRF_TRUSTED_ORIGINS=

# PostgreSQL
DB_NAME=prepit_db
DB_USER=prepit_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Gemini (backend only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Production HTTPS settings; enable after the HTTPS domain is configured
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
